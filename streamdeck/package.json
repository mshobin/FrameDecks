{
  "name": "framedecks-streamdeck",
  "version": "1.0.0",
  "private": true,
  "description": "FRAMEDECKS plugin for Elgato Stream Deck (runs FRAMEDECKS actions on this PC like its keys).",
  "type": "module",
  "scripts": {
    "test": "node --test test/framedecks.test.mjs",
    "build": "esbuild src/plugin.js --bundle --platform=node --format=esm --target=node24 --outfile=com.framedecks.control.sdPlugin/bin/plugin.js",
    "validate": "streamdeck validate com.framedecks.control.sdPlugin",
    "pack": "streamdeck pack com.framedecks.control.sdPlugin --output dist --force"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.3"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.3",
    "esbuild": "0.28.2"
  }
}
